# Optional AI provider, server-side only. Missing values use DEMO mode.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Server-only PostgreSQL connection string. Leave empty for DEMO mode.
DATABASE_URL=
# Exact application origin; use HTTPS on Vercel.
APP_ORIGIN=http://localhost:3000
# Keep disabled until live integration and security reviews are complete.
PAYMENTS_ENABLED=false

# Public Testnet contract ID and SHA-256 of its verified deployed WASM.
# Keep signing disabled until database and wallet recovery checks pass.
V2_TREASURY_CONTRACT_ID=agentledger-v2.agentledger-owner.testnet
V2_TREASURY_WASM_SHA256=7c38929d075d06e47a9af6472387939f5473d27e4e3ced7d88e2eaf0244c3d27
V2_PAYMENTS_ENABLED=false
